/* Dark Theme */
/* Base Shape */
QComboBox {
        /* Shape ComboBox */
        background-color: #f5f5f5;
        border: 1px solid #1a1b1b;
        border-radius: 3px;

        /* Font ComboBox */
        font-family: 'MollenNarrow_Regular', 'NotoSansSC_Regular';
        font-size: 10pt;
        padding: 0px 5px;
        color: #1b1e20;
}

/* Arrow Icon */
QComboBox::down-arrow {
        image: url(:/Icons/Arrow_Down.svg);
        width: 14px;
        height: 14px;
}

QComboBox::drop-down:!editable {
        background-color: #645ac8;
        border: 2px solid #645ac8;
        border-top-right-radius: 3px;
        border-bottom-right-radius: 3px;
        width: 20px;
}

/* Drop Down Menu */
QComboBox QAbstractItemView {
        background-color: #f5f5f5;

        /* Font ComboBox */
        font-family: 'MollenNarrow_Regular', 'NotoSansSC_Regular';
        font-size: 10pt;
        color: #1b1e20;
}

QComboBox QAbstractItemView::item::selected {
        background-color: #69b5ff;
}
