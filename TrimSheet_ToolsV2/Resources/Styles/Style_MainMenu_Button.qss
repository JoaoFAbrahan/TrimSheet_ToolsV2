/* Dark Theme */
/* Idle Style State */
QPushButton {
    /* Shape Button */
    background-color: #1B1E20;
    border-radius: 5px;

    /* Font Button */
    color: #f5f5f5;
    font-family: 'MollenNarrow_Bold';
    font-size: 8pt;
    font-weight: bold;
    text-align: left;
    padding-right: 6px;
    padding-left: 6px;

    /* Icon Button */
    qproperty-iconSize: 30px 30px;
}

QPushButton:hover {
    background-color: #645AC8;
}

QPushButton:pressed {
    background-color: #5441F6;
}

QPushButton:disabled {
    color: #333333;
    background-color: #1B1E20;
}

QPushButton:checked {
    background-color: #5441F6;
}
=== Theme ===
/* Light Theme */
/* Idle Style State */
QPushButton {
    /* Shape Button */
    background-color: #ffffff;
    border-radius: 5px;

    /* Font Button */
    color: #0a142a;
    font-family: 'MollenNarrow_Bold';
    font-size: 8pt;
    font-weight: bold;
    text-align: left;
    padding-right: 6px;
    padding-left: 6px;

    /* Icon Button */
    qproperty-iconSize: 30px 30px;
}

QPushButton:hover {
    /* Shape Button */
    background-color: #717bdb;

    /* Font Button */
    color: #f5f5f5;
}

QPushButton:pressed {
    /* Shape Button */
    background-color: #4e56dc;

    /* Font Button */
    color: #f5f5f5;
}

QPushButton:disabled {
    color: #e6e6e6;
    background-color: #ffffff;
}

QPushButton:checked {
    /* Shape Button */
    background-color: #4e56dc;

    /* Font Button */
    color: #f5f5f5;
}
